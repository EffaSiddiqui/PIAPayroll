@model PIA.Payroll.Web.ViewModels.SalaryStructuresListViewModel
@{
    ViewData["Title"] = "Salary Structures - PIA Payroll";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-success fw-bold">Payroll</a></li>
                <li class="breadcrumb-item active" aria-current="page">Salary Structures</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-dark mb-0">Employee Salary Configurations</h4>
        <small class="text-muted">Set baseline salaries, allowances, and mandatory deductions per staff member</small>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-light border px-3 py-2" style="border-radius: 10px;">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Operations
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #d1e7dd; color: #0f5132;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-custom p-4">
    <h5 class="fw-bold mb-3">Active Salary Master List</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase text-secondary">
                    <th>Code</th>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>Basic Salary</th>
                    <th>Allowances</th>
                    <th>Gross Salary</th>
                    <th>Deductions</th>
                    <th>Net Salary</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Structures.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <p class="mb-0">No personnel records found.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model.Structures)
                    {
                        <tr>
                            <td class="font-monospace fw-bold" style="color: #08663e;">@s.EmployeeCode</td>
                            <td>
                                <div class="fw-bold text-dark">@s.EmployeeName</div>
                                <small class="text-muted">@(s.DesignationName ?? "General Staff")</small>
                            </td>
                            <td>@(s.DepartmentName ?? "-")</td>
                            <td class="small fw-semibold">PKR @s.BasicSalary.ToString("N0")</td>
                            <td class="small text-muted">PKR @s.TotalAllowances.ToString("N0")</td>
                            <td class="small fw-bold text-dark">PKR @s.GrossSalary.ToString("N0")</td>
                            <td class="small text-danger">PKR @s.TotalDeductions.ToString("N0")</td>
                            <td class="small fw-bold text-success">PKR @s.NetSalary.ToString("N0")</td>
                            <td class="text-end">
                                <a asp-action="EditSalaryStructure" asp-route-employeeId="@s.EmployeeId" class="btn btn-sm btn-light border" style="border-radius: 8px;">
                                    <i class="fa-solid fa-sliders me-1"></i> Configure
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>