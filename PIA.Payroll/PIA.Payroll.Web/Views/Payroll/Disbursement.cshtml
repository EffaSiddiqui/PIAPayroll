@{
    ViewData["Title"] = "Bank Disbursement File - PIA Payroll";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold m-0">Corporate Bank Salary Transfer Dispatch</h4>
        <small class="text-muted">State Bank of Pakistan (SBP) & Commercial Banks Direct Deposit File Generator</small>
    </div>
    <a href="/Payroll" class="btn btn-light border px-3 py-2" style="border-radius: 10px;">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Payroll
    </a>
</div>

<div class="card card-custom p-4 text-white mb-4" style="background-color: #032014; border-left: 5px solid #c29b38;">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold text-white mb-1">September 2026 Batch Ready for Disbursement</h5>
            <p class="mb-0 text-light opacity-75 small">Total Headcount: 1,248 Employees | Aggregate Net Outlay: <strong>PKR 4,230,000</strong></p>
        </div>
        <button class="btn btn-warning text-dark fw-bold px-4 py-2" style="border-radius: 10px;">
            <i class="fa-solid fa-file-excel me-2"></i> Export SBP / Bank File (CSV)
        </button>
    </div>
</div>

<div class="card card-custom p-4">
    <h5 class="fw-bold mb-3">Bank Batch Wise Distribution</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase text-secondary">
                    <th>Bank Name</th>
                    <th>Branch Code / Account Type</th>
                    <th>Staff Count</th>
                    <th>Total Batch Transfer</th>
                    <th class="text-end">Batch Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="fw-bold text-dark">National Bank of Pakistan (NBP)</span></td>
                    <td>Main Corporate Branch (0012)</td>
                    <td>780 Staff</td>
                    <td class="fw-bold text-success">PKR 2,650,000</td>
                    <td class="text-end"><span class="badge bg-success">Ready for Transit</span></td>
                </tr>
                <tr>
                    <td><span class="fw-bold text-dark">Habib Bank Limited (HBL)</span></td>
                    <td>Airport Branch (0104)</td>
                    <td>310 Staff</td>
                    <td class="fw-bold text-success">PKR 1,120,000</td>
                    <td class="text-end"><span class="badge bg-success">Ready for Transit</span></td>
                </tr>
                <tr>
                    <td><span class="fw-bold text-dark">Meezan Bank Limited</span></td>
                    <td>Islamic Banking Branch (0301)</td>
                    <td>158 Staff</td>
                    <td class="fw-bold text-success">PKR 460,000</td>
                    <td class="text-end"><span class="badge bg-success">Ready for Transit</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>