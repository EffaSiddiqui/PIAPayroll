@model PIA.Payroll.Web.ViewModels.PayrollDashboardViewModel
@{
    ViewData["Title"] = "Payroll Cycles - PIA Payroll";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold m-0">PIA Payroll Cycles & Operations</h4>
        <small class="text-muted">Enterprise Remuneration, Allowances & Monthly Disbursements</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="SalaryStructures" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 10px;">
            <i class="fa-solid fa-sliders me-1"></i> Salary Structures
        </a>
        <a asp-action="CreatePeriod" class="btn btn-pia px-3 py-2">
            <i class="fa-solid fa-calendar-plus me-1"></i> Initialize New Cycle
        </a>
    </div>
</div>

<!-- Alert Notifications -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #d1e7dd; color: #0f5132;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Dashboard Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-success">
            <small class="text-muted text-uppercase fw-bold">Total Managed Cycles</small>
            <h3 class="fw-bold my-1">@Model.Summary.TotalPeriods</h3>
            <small class="text-muted"><i class="fa-solid fa-calendar-days me-1"></i> Historical & Active</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-warning">
            <small class="text-muted text-uppercase fw-bold">Processed Batches</small>
            <h3 class="fw-bold my-1 text-warning">@Model.Summary.ProcessedPeriodsCount</h3>
            <small class="text-muted"><i class="fa-solid fa-gears me-1"></i> Calculated Batches</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-primary">
            <small class="text-muted text-uppercase fw-bold">Total Disbursed (Paid)</small>
            <h3 class="fw-bold my-1 text-primary">PKR @Model.Summary.TotalNetDisbursed.ToString("N0")</h3>
            <small class="text-muted"><i class="fa-solid fa-building-columns me-1"></i> Finalized Net Outlay</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-info">
            <small class="text-muted text-uppercase fw-bold">Active Personnel</small>
            <h3 class="fw-bold my-1">@Model.Summary.ActiveEmployeesCount</h3>
            <small class="text-muted"><i class="fa-solid fa-users me-1"></i> Eligible Staff</small>
        </div>
    </div>
</div>

<!-- Periods Table -->
<div class="card card-custom p-4">
    <h5 class="fw-bold mb-3">Payroll Periods History</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase text-secondary">
                    <th>Cycle Name</th>
                    <th>Date Span</th>
                    <th>Headcount</th>
                    <th>Gross Outlay</th>
                    <th>Deductions</th>
                    <th>Net Payout</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Periods.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-calendar-xmark fa-3x mb-3 text-secondary"></i>
                            <h6 class="fw-bold">No Payroll Periods Found</h6>
                            <p class="small text-muted mb-3">No monthly payroll cycles have been initiated yet.</p>
                            <a asp-action="CreatePeriod" class="btn btn-pia btn-sm">Create First Payroll Cycle</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var period in Model.Periods)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@period.Id" class="text-decoration-none text-dark">
                                    @period.PeriodName
                                </a>
                            </td>
                            <td class="small text-muted text-nowrap">
                                @period.StartDate.ToString("dd MMM yyyy") &ndash; @period.EndDate.ToString("dd MMM yyyy")
                            </td>
                            <td>@period.TotalEmployeesProcessed</td>
                            <td class="small fw-semibold">PKR @period.TotalGrossSalary.ToString("N0")</td>
                            <td class="small text-danger">PKR @period.TotalDeductions.ToString("N0")</td>
                            <td class="small fw-bold text-success">PKR @period.TotalNetSalary.ToString("N0")</td>
                            <td>
                                @if (period.Status == "Paid")
                                {
                                    <span class="badge bg-success px-2 py-1">PAID</span>
                                }
                                else if (period.Status == "Processed")
                                {
                                    <span class="badge bg-primary px-2 py-1">PROCESSED</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1">DRAFT</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@period.Id" class="btn btn-sm btn-light">
                                    @(period.Status == "Draft" ? "Process / View" : "Details")
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>