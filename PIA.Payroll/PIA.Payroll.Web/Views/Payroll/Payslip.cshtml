@model PIA.Payroll.Application.DTOs.PayslipDto
@{
    ViewData["Title"] = $"Payslip - {Model.EmployeeCode} - {Model.PeriodName}";
}

<!-- Action Bar (Hidden on Print) -->
<div class="mb-4 d-print-none">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-success fw-bold">Payroll</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.PayrollPeriodId" class="text-decoration-none text-success fw-bold">@Model.PeriodName</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.EmployeeCode Payslip</li>
                </ol>
            </nav>
            <h4 class="fw-bold text-dark mb-0">Employee Remuneration Advice</h4>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <a asp-action="Details" asp-route-id="@Model.PayrollPeriodId" class="btn btn-light border px-3 py-2" style="border-radius: 10px;">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Cycle
                </a>
            }
            else
            {
                <a asp-action="MyPayslips" class="btn btn-light border px-3 py-2" style="border-radius: 10px;">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to My Payslips
                </a>
            }
            <button type="button" class="btn text-white px-3 py-2" style="background-color: #08663e; border-radius: 10px; font-weight: 600;" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> Print / Download PDF
            </button>
        </div>
    </div>
</div>

<!-- Printable Payslip Card Container -->
<div class="card card-custom shadow-sm border-0 col-lg-10 mx-auto bg-white p-2">
    <div class="card-body p-4 p-md-5">
        <!-- Payslip Header -->
        <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-white rounded p-1 shadow-sm d-flex align-items-center justify-content-center" style="border: 1px solid rgba(0,0,0,0.1);">
                    <img src="/images/pia-logo.png" alt="PIA Logo" style="height: 65px; object-fit: contain;">
                </div>
                <div>
                    <h3 class="h4 fw-bold text-dark mb-0" style="letter-spacing: 0.5px;">PAKISTAN INTERNATIONAL AIRLINES</h3>
                    <p class="text-muted small mb-0">Enterprise Human Capital & Remuneration Directorate</p>
                    <span class="badge text-white mt-1 px-2 py-1" style="background-color: #032014; border-radius: 6px; font-size: 0.7rem;">CONFIDENTIAL SALARY STATEMENT</span>
                </div>
            </div>
            <div class="text-end">
                <h5 class="fw-bold mb-1" style="color: #08663e;">@Model.PeriodName</h5>
                <span class="small text-muted d-block">Period ID: #@Model.PayrollPeriodId</span>
                @if (Model.PaymentStatus == "Paid")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 mt-1">STATUS: PAID</span>
                }
                else
                {
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1 mt-1">STATUS: PROCESSED</span>
                }
            </div>
        </div>

        <!-- Employee Particulars Grid -->
        <div class="p-3 rounded-3 mb-4 border" style="background-color: #f8fafc;">
            <div class="row g-2 small">
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted text-uppercase d-block" style="font-size: 0.725rem;">Employee Code</span>
                    <strong class="font-monospace fs-6" style="color: #08663e;">@Model.EmployeeCode</strong>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted text-uppercase d-block" style="font-size: 0.725rem;">Employee Name</span>
                    <strong class="text-dark">@Model.EmployeeName</strong>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted text-uppercase d-block" style="font-size: 0.725rem;">Father's Name</span>
                    <span class="text-dark">@Model.FatherName</span>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted text-uppercase d-block" style="font-size: 0.725rem;">National CNIC</span>
                    <span class="font-monospace text-dark">@Model.CNIC</span>
                </div>
                <div class="col-sm-6 col-md-3 mt-2">
                    <span class="text-muted text-uppercase d-block" style="font-size: 0.725rem;">Department</span>
                    <span class="text-dark fw-semibold">@(Model.DepartmentName ?? "General Staff")</span>
                </div>
                <div class="col-sm-6 col-md-3 mt-2">
                    <span class="text-muted text-uppercase d-block" style="font-size: 0.725rem;">Designation</span>
                    <span class="text-dark fw-semibold">@(Model.DesignationName ?? "Staff")</span>
                </div>
                <div class="col-sm-6 col-md-3 mt-2">
                    <span class="text-muted text-uppercase d-block" style="font-size: 0.725rem;">Official Email</span>
                    <span class="text-dark">@Model.OfficialEmail</span>
                </div>
                <div class="col-sm-6 col-md-3 mt-2">
                    <span class="text-muted text-uppercase d-block" style="font-size: 0.725rem;">Issue Date</span>
                    <span class="text-dark">@Model.GeneratedDate.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>

        <!-- Breakdown: Earnings vs Deductions -->
        <div class="row g-4 mb-4">
            <!-- Earnings -->
            <div class="col-md-6">
                <div class="border rounded-3 h-100 p-3">
                    <div class="bg-light p-2 px-3 border-bottom rounded-2 mb-2">
                        <h6 class="fw-bold text-dark mb-0 small text-uppercase">
                            <i class="fa-solid fa-circle-plus text-success me-1"></i> Earnings & Allowances
                        </h6>
                    </div>
                    <div class="p-2">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted">Basic Salary</td>
                                    <td class="text-end fw-semibold">PKR @Model.BasicSalary.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">House Rent Allowance</td>
                                    <td class="text-end">PKR @Model.HouseRentAllowance.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Medical Allowance</td>
                                    <td class="text-end">PKR @Model.MedicalAllowance.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Special / Aviation Allowance</td>
                                    <td class="text-end">PKR @Model.SpecialAllowance.ToString("N0")</td>
                                </tr>
                            </tbody>
                            <tfoot class="border-top">
                                <tr>
                                    <th class="pt-2 text-dark">Gross Earnings</th>
                                    <th class="pt-2 text-end text-success fs-6">PKR @Model.GrossSalary.ToString("N0")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Deductions -->
            <div class="col-md-6">
                <div class="border rounded-3 h-100 p-3">
                    <div class="bg-light p-2 px-3 border-bottom rounded-2 mb-2">
                        <h6 class="fw-bold text-dark mb-0 small text-uppercase">
                            <i class="fa-solid fa-circle-minus text-danger me-1"></i> Deductions & Retentions
                        </h6>
                    </div>
                    <div class="p-2">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted">Income Tax Withholding</td>
                                    <td class="text-end text-danger">PKR @Model.IncomeTaxDeduction.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Provident Fund (Employee)</td>
                                    <td class="text-end text-danger">PKR @Model.ProvidentFundDeduction.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Other / Miscellaneous Deductions</td>
                                    <td class="text-end text-danger">PKR @Model.OtherDeductions.ToString("N0")</td>
                                </tr>
                            </tbody>
                            <tfoot class="border-top">
                                <tr>
                                    <th class="pt-2 text-dark">Total Deductions</th>
                                    <th class="pt-2 text-end text-danger fs-6">PKR @Model.TotalDeductions.ToString("N0")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Net Payable Highlight Banner -->
        <div class="p-4 rounded-3 text-center mb-4 text-white" style="background-color: #032014; border-left: 5px solid #c29b38;">
            <span class="text-uppercase fw-bold text-warning small d-block mb-1">Net Take-Home Remuneration</span>
            <div class="display-6 fw-bold mb-0 font-monospace text-white">
                PKR @Model.NetSalary.ToString("N0")
            </div>
            <small class="text-light mt-1 d-block opacity-75">Credited to employee designated corporate bank account</small>
        </div>

        <!-- Verification & Signature Footer -->
        <div class="row pt-4 mt-4 border-top text-muted small">
            <div class="col-6">
                <p class="mb-0">This document is system-generated and certified under Pakistan International Airlines corporate payroll regulations.</p>
            </div>
            <div class="col-6 text-end">
                <div class="mt-3 pt-2 d-inline-block border-top border-dark text-center" style="min-width: 180px;">
                    <span class="d-block fw-semibold text-dark">Director Finance / Payroll</span>
                    <span class="text-muted" style="font-size: 0.725rem;">Authorized Signature</span>
                </div>
            </div>
        </div>
    </div>
</div>