@model PIA.Payroll.Web.ViewModels.EmployeeListViewModel

@{
    ViewData["Title"] = "Employee Directory";
}

<!-- Alert Message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #d1e7dd; color: #0f5132;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0 text-dark">Workforce Directory</h3>
        <small class="text-muted">Manage cadres, designations, and salary scales</small>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <button class="btn btn-pia px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
            <i class="fa-solid fa-plus me-2"></i> Add Employee
        </button>
    }
</div>

<!-- Search Bar -->
<div class="card card-custom p-2 mb-4 shadow-sm border-0" style="border-radius: 12px; background: #fff;">
    <form method="get" action="/Employee">
        <div class="d-flex gap-2">
            <div class="flex-grow-1 position-relative">
                <i class="fa-solid fa-search position-absolute text-muted" style="left: 15px; top: 50%; transform: translateY(-50%);"></i>
                <input type="text" name="SearchTerm" class="form-control bg-light border-0" placeholder="Search by Name, Code, or Email..." style="border-radius: 8px; padding-left: 45px; padding-top: 12px; padding-bottom: 12px;">
            </div>
            <div>
                <button type="submit" class="btn btn-pia h-100 px-4" style="border-radius: 8px;">Search</button>
            </div>
        </div>
    </form>
</div>

<!-- Workforce Table -->
<div class="card card-custom p-0 border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color: #f8f9fa;">
                    <th class="py-3 px-4 text-muted small text-uppercase fw-bold border-0">Emp ID (PNo)</th>
                    <th class="py-3 px-4 text-muted small text-uppercase fw-bold border-0">Name & Contact</th>
                    <th class="py-3 px-4 text-muted small text-uppercase fw-bold border-0">Role & Dept</th>
                    <th class="py-3 px-4 text-muted small text-uppercase fw-bold border-0">Location</th>
                    <th class="py-3 px-4 text-muted small text-uppercase fw-bold border-0">Status</th>
                    <th class="py-3 px-4 text-muted small text-uppercase fw-bold border-0 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (Model?.Employees != null && Model.Employees.Any())
                {
                    foreach (var emp in Model.Employees)
                    {
                        <tr>
                            <td class="px-4"><span class="fw-bold" style="color: var(--pia-accent-green);">#@emp.EmployeeCode</span></td>
                            <td class="px-4">
                                <div class="fw-bold text-dark">@emp.FullName</div>
                                <small class="text-muted d-block"><i class="fa-regular fa-envelope me-1"></i>@emp.OfficialEmail</small>
                                <small class="text-muted d-block"><i class="fa-solid fa-phone me-1"></i>@emp.CellPhoneNumber <span class="ms-2">Ext: @emp.Extension</span></small>
                            </td>
                            <td class="px-4">
                                <div class="fw-semibold text-dark">@(emp.DesignationName ?? "General Staff")</div>
                                <span class="badge bg-light text-dark border px-2 py-1 mt-1">@emp.DepartmentName</span>
                            </td>
                            <td class="px-4 text-muted">@emp.Location</td>
                            <td class="px-4">
                                <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill"><i class="fa-solid fa-circle me-1" style="font-size: 6px; vertical-align: middle;"></i> Active</span>
                            </td>
                            <td class="px-4 text-end">
                                <div class="btn-group shadow-sm" role="group">
                                    <a href="/Employee/Details/@emp.Id" class="btn btn-sm btn-light border-0"><i class="fa-solid fa-eye text-primary"></i></a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                    {
                                        <a href="/Employee/Edit/@emp.Id" class="btn btn-sm btn-light border-0"><i class="fa-solid fa-pen text-warning"></i></a>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form method="post" action="/Employee/Delete/@emp.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this employee? This cannot be undone.');">
                                            <button type="submit" class="btn btn-sm btn-light border-0 text-danger" title="Delete Employee">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-users-slash fs-1 text-light mb-3 mt-3 d-block"></i>
                            <h5 class="fw-bold text-dark">No employees found</h5>
                            <p class="small">Try adjusting your search or filters.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
<!-- Add Employee Popup Modal -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg" style="border-radius: 20px; border: none; overflow: hidden;">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #01160a 0%, #032014 100%); padding: 24px 30px;">
                <h5 class="modal-title fw-bold text-white" id="addEmployeeModalLabel">
                    <i class="fa-solid fa-user-plus me-2" style="color: #c29b38;"></i>Add New PIA Employee
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Employee/Create">
                <div class="modal-body p-4" style="background-color: #f8fafc;">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Employee ID / P-Number</label>
                            <input type="text" class="form-control" name="Employee.EmployeeCode" placeholder="e.g. 10003" required style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">First Name</label>
                            <input type="text" class="form-control" name="Employee.FirstName" placeholder="e.g. Effa" required style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Last Name</label>
                            <input type="text" class="form-control" name="Employee.LastName" placeholder="e.g. Siddiqui" required style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Official Email</label>
                            <input type="email" class="form-control" name="Employee.OfficialEmail" placeholder="effa@piac.aero" required style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Department</label>
                            <select class="form-select" name="Employee.DepartmentId" style="border-radius: 10px;">
                                <option value="1">Flight Operations</option>
                                <option value="2">Engineering</option>
                                <option value="3">Ground Handling</option>
                                <option value="4">Finance & Admin</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Father's Name</label>
                            <input type="text" class="form-control" name="Employee.FatherName" placeholder="e.g. Ali" required style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">CNIC</label>
                            <input type="text" class="form-control" name="Employee.CNIC" placeholder="42101-1234567-1" required style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Date of Birth</label>
                            <input type="date" class="form-control" name="Employee.DateOfBirth" required style="border-radius: 10px;" value="1995-01-01">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Gender</label>
                            <select class="form-select" name="Employee.Gender" style="border-radius: 10px;">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Phone Number</label>
                            <input type="text" class="form-control" name="Employee.PhoneNumber" placeholder="e.g. 021-1234567" required style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Joining Date</label>
                            <input type="date" class="form-control" name="Employee.JoiningDate" required style="border-radius: 10px;" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Location</label>
                            <input type="text" class="form-control" name="Employee.Location" placeholder="e.g. Head Office" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Extension</label>
                            <input type="text" class="form-control" name="Employee.Extension" placeholder="e.g. 1234" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Cell Phone No</label>
                            <input type="text" class="form-control" name="Employee.CellPhoneNumber" placeholder="e.g. 0300-1234567" style="border-radius: 10px;">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 p-3" style="background-color: #ffffff;">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="border-radius: 10px;">Cancel</button>
                    <button type="submit" class="btn text-white px-4" style="background-color: #08663e; border-radius: 10px; font-weight: 600;">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>
}