@model PIA.Payroll.Web.ViewModels.EmployeeEditViewModel
@{
    ViewData["Title"] = $"Edit Employee - {Model.Employee.FirstName} {Model.Employee.LastName}";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-pia">Employees</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Employee.Id" class="text-decoration-none text-pia">@Model.Employee.EmployeeCode</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Profile</li>
        </ol>
    </nav>
    <h1 class="h3 fw-bold text-dark mb-1">Edit Employee Profile</h1>
    <p class="text-muted mb-0">Update personal and corporate details for @Model.Employee.FirstName @Model.Employee.LastName</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Edit" asp-route-id="@Model.Employee.Id" method="post">
            <input type="hidden" asp-for="Employee.Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <h5 class="fw-bold text-dark border-bottom pb-2 mb-4">
                1. Personal Particulars & Identification
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Employee.EmployeeCode" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.EmployeeCode" class="form-control font-monospace" />
                    <span asp-validation-for="Employee.EmployeeCode" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.FirstName" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.FirstName" class="form-control" />
                    <span asp-validation-for="Employee.FirstName" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.LastName" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.LastName" class="form-control" />
                    <span asp-validation-for="Employee.LastName" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.FatherName" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.FatherName" class="form-control" />
                    <span asp-validation-for="Employee.FatherName" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.CNIC" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.CNIC" class="form-control font-monospace" />
                    <span asp-validation-for="Employee.CNIC" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.Gender" class="form-label fw-semibold small text-secondary"></label>
                    <select asp-for="Employee.Gender" class="form-select">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Employee.Gender" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.DateOfBirth" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="Employee.DateOfBirth" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.PhoneNumber" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.PhoneNumber" class="form-control" />
                    <span asp-validation-for="Employee.PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.PersonalEmail" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.PersonalEmail" type="email" class="form-control" />
                    <span asp-validation-for="Employee.PersonalEmail" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.CellPhoneNumber" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.CellPhoneNumber" class="form-control" />
                    <span asp-validation-for="Employee.CellPhoneNumber" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="fw-bold text-dark border-bottom pb-2 mb-4 pt-3">
                2. Corporate Deployment & Service
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Employee.OfficialEmail" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.OfficialEmail" type="email" class="form-control" />
                    <span asp-validation-for="Employee.OfficialEmail" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Employee.JoiningDate" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.JoiningDate" type="date" class="form-control" />
                    <span asp-validation-for="Employee.JoiningDate" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.DepartmentId" class="form-label fw-semibold small text-secondary"></label>
                    <select asp-for="Employee.DepartmentId" class="form-select">
                        <option value="">-- Select Department --</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id">@dept.Name (@dept.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="Employee.DepartmentId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.DesignationId" class="form-label fw-semibold small text-secondary"></label>
                    <select asp-for="Employee.DesignationId" class="form-select">
                        <option value="">-- Select Designation --</option>
                        @foreach (var desig in Model.Designations)
                        {
                            <option value="@desig.Id">@desig.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Employee.DesignationId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.EmploymentStatus" class="form-label fw-semibold small text-secondary"></label>
                    <select asp-for="Employee.EmploymentStatus" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <span asp-validation-for="Employee.EmploymentStatus" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.Location" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.Location" class="form-control" />
                    <span asp-validation-for="Employee.Location" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.Extension" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Employee.Extension" class="form-control" />
                    <span asp-validation-for="Employee.Extension" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Details" asp-route-id="@Model.Employee.Id" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-pia-primary px-5 fw-semibold shadow-sm">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}