<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PIA Payroll & HRMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           ROOT DESIGN TOKENS (MATCHING LOGIN THEME)
        ============================================================ */
        :root {
            --pia-green:       #005A36; /* Official PIA Green */
            --pia-green-dark:  #00331E;
            --pia-green-mid:   #00472A;
            --pia-green-light: #087548;
            --pia-gold:        #D4AF37; /* PIA Gold Accent */
            --pia-gold-light:  #F3E5AB;
            --pia-gold-dark:   #B8860B;

            --gold:          var(--pia-gold);
            --gold-light:    var(--pia-gold-light);
            --gold-dark:     var(--pia-gold-dark);
            --forest:        var(--pia-green);
            --forest-dark:   var(--pia-green-dark);
            --forest-mid:    var(--pia-green-mid);
            --forest-light:  var(--pia-green-light);
            --surface:       #ffffff;
            --surface-2:     #f8fafc;
            --border:        #e2e8f0;
            --text-primary:  #0f172a;
            --text-muted:    #64748b;
            --text-light:    #94a3b8;
            --sidebar-w:     260px;
            --navbar-h:      64px;
            --ribbon-h:      36px;
        }

        [data-theme="dark"] {
            --surface:       #00331E;
            --surface-2:     #001f12;
            --border:        #004d2e;
            --text-primary:  #f8fafc;
            --text-muted:    #94a3b8;
            --text-light:    #64748b;
        }

        /* ============================================================
           RESET & BASE
        ============================================================ */
        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--surface-2);
            color: var(--text-primary);
            margin: 0;
            padding: 0;
            transition: background-color 0.3s, color 0.3s;
        }

        /* ============================================================
           SIDEBAR
        ============================================================ */
        .pia-sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            position: fixed;
            top: 0; left: 0;
            background: linear-gradient(180deg, var(--forest) 0%, var(--forest-dark) 100%);
            display: flex;
            flex-direction: column;
            z-index: 1050;
            box-shadow: 4px 0 32px rgba(0,0,0,0.25);
            border-right: 1px solid rgba(197,155,39,0.15);
        }

        /* Logo area */
        .sidebar-brand {
            padding: 20px 20px 16px;
            border-bottom: 1px solid rgba(197,155,39,0.2);
            background: rgba(0,0,0,0.2);
        }
        .sidebar-brand img {
            max-width: 100%;
            height: 68px;
            object-fit: contain;
        }
        .sidebar-brand-logo-wrap {
            background: #fff;
            border-radius: 10px;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Section label */
        .sidebar-section-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: var(--gold);
            padding: 16px 20px 6px;
            opacity: 0.7;
        }

        /* Nav links */
        .sidebar-nav { list-style: none; padding: 0; margin: 0; flex: 1; overflow-y: auto; }
        .sidebar-nav li a, .sidebar-nav li button.nav-link-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 20px;
            color: rgba(255,255,255,0.6);
            font-size: 13.5px;
            font-weight: 500;
            text-decoration: none;
            border: none;
            background: none;
            width: 100%;
            cursor: pointer;
            border-left: 3px solid transparent;
            transition: all 0.25s ease;
            position: relative;
        }
        .sidebar-nav li a i, .sidebar-nav li button.nav-link-btn i {
            width: 18px;
            text-align: center;
            font-size: 14px;
            color: rgba(255,255,255,0.4);
            transition: color 0.25s;
        }
        .sidebar-nav li a:hover, .sidebar-nav li button.nav-link-btn:hover {
            color: #fff;
            background: rgba(197,155,39,0.08);
            border-left-color: var(--gold);
        }
        .sidebar-nav li a:hover i, .sidebar-nav li button.nav-link-btn:hover i {
            color: var(--gold);
        }
        .sidebar-nav li a.active {
            color: var(--gold);
            background: rgba(197,155,39,0.12);
            border-left-color: var(--gold);
            font-weight: 600;
        }
        .sidebar-nav li a.active i { color: var(--gold); }

        /* Sidebar footer */
        .sidebar-footer {
            border-top: 1px solid rgba(197,155,39,0.15);
            padding: 14px 20px;
        }

        /* ============================================================
           TELEMETRY RIBBON (top strip)
        ============================================================ */
        .telemetry-ribbon {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--ribbon-h);
            background: var(--forest-dark);
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 20px;
            z-index: 1040;
            border-bottom: 1px solid rgba(197,155,39,0.15);
        }
        .ribbon-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: rgba(255,255,255,0.55);
        }
        .ribbon-pill .dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #22c55e;
            animation: pulse-dot 2s infinite;
        }
        .ribbon-pill .dot.gold { background: var(--gold); animation: none; }
        .ribbon-pill .dot.red { background: #ef4444; animation: none; }
        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
        .ribbon-time {
            margin-left: auto;
            font-size: 10.5px;
            color: rgba(255,255,255,0.4);
            font-family: 'Inter', monospace;
            letter-spacing: 0.5px;
        }

        /* ============================================================
           MAIN NAVBAR
        ============================================================ */
        .pia-navbar {
            position: fixed;
            top: var(--ribbon-h);
            left: var(--sidebar-w);
            right: 0;
            height: var(--navbar-h);
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 16px;
            z-index: 1039;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            transition: background 0.3s;
        }
        .navbar-page-title {
            font-family: 'Playfair Display', serif;
            font-size: 19px;
            font-weight: 700;
            color: var(--forest);
            letter-spacing: -0.3px;
            margin: 0;
            line-height: 1;
        }
        [data-theme="dark"] .navbar-page-title { color: #fff; }
        .navbar-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }

        /* Theme toggle */
        .theme-toggle-btn {
            width: 36px; height: 36px;
            border-radius: 50%;
            border: 1.5px solid var(--border);
            background: var(--surface-2);
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 13px;
        }
        .theme-toggle-btn:hover {
            border-color: var(--gold);
            color: var(--gold);
            background: rgba(197,155,39,0.08);
        }
        [data-theme="dark"] .theme-toggle-btn {
            background: var(--forest-mid);
            border-color: rgba(197,155,39,0.3);
            color: var(--gold);
        }

        /* User chip */
        .user-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--surface-2);
            border: 1.5px solid var(--border);
            border-radius: 100px;
            padding: 5px 14px 5px 8px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-primary);
            transition: border-color 0.2s;
        }
        .user-chip:hover { border-color: var(--gold); }
        .user-avatar {
            width: 26px; height: 26px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--forest) 0%, var(--gold-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: #fff;
            font-weight: 700;
        }

        /* ============================================================
           MAIN CONTENT AREA
        ============================================================ */
        .main-wrapper {
            margin-left: var(--sidebar-w);
            padding-top: calc(var(--ribbon-h) + var(--navbar-h));
            min-height: 100vh;
        }
        .content-body {
            padding: 28px 32px;
        }

        /* ============================================================
           CARDS
        ============================================================ */
        .card-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            transition: box-shadow 0.3s;
            overflow: hidden;
        }
        .card-panel:hover {
            box-shadow: 0 8px 28px rgba(0,0,0,0.08);
        }
        .card-panel.gold-top { border-top: 3px solid var(--gold); }
        .card-panel.green-top { border-top: 3px solid var(--forest); }

        /* Legacy card-custom support */
        .card-custom {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        }
        .card-custom:hover {
            box-shadow: 0 8px 28px rgba(0,0,0,0.08);
        }

        /* Card header */
        .card-panel-header {
            padding: 16px 22px 14px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .card-panel-title {
            font-family: 'Playfair Display', serif;
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        .card-panel-body { padding: 22px; }

        /* ============================================================
           KPI METRIC TILES
        ============================================================ */
        .kpi-tile {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 22px 24px;
            border-top: 3px solid var(--gold);
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }
        .kpi-tile::before {
            content: '';
            position: absolute;
            top: -40px; right: -40px;
            width: 100px; height: 100px;
            border-radius: 50%;
            background: rgba(197,155,39,0.05);
        }
        .kpi-tile:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.1);
            border-top-color: var(--gold-light);
        }
        .kpi-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: var(--text-light);
            margin-bottom: 10px;
        }
        .kpi-value {
            font-family: 'Playfair Display', serif;
            font-size: 30px;
            font-weight: 700;
            color: var(--gold-dark);
            line-height: 1;
            margin-bottom: 8px;
        }
        .kpi-sub {
            font-size: 11.5px;
            color: var(--text-muted);
            font-weight: 500;
        }
        .kpi-icon {
            position: absolute;
            top: 20px; right: 20px;
            width: 40px; height: 40px;
            border-radius: 10px;
            background: rgba(197,155,39,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gold);
            font-size: 16px;
        }

        /* ============================================================
           TABLES
        ============================================================ */
        .exec-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .exec-table thead tr {
            background: var(--forest);
        }
        .exec-table thead th {
            padding: 12px 16px;
            color: rgba(255,255,255,0.75);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            white-space: nowrap;
        }
        .exec-table thead th:first-child { border-radius: 0; }
        .exec-table thead th:last-child { border-radius: 0; }
        .exec-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background 0.15s;
        }
        .exec-table tbody tr:nth-child(even) {
            background: var(--surface-2);
        }
        .exec-table tbody tr:hover {
            background: rgba(197,155,39,0.06);
        }
        .exec-table tbody td {
            padding: 12px 16px;
            color: var(--text-primary);
            vertical-align: middle;
            border: none;
        }

        /* Override Bootstrap table in dark mode */
        [data-theme="dark"] .exec-table tbody tr {
            border-bottom-color: var(--border);
        }
        [data-theme="dark"] .exec-table tbody td {
            color: #e0f0e8;
        }
        [data-theme="dark"] .exec-table tbody tr:nth-child(even) {
            background: rgba(255,255,255,0.025);
        }
        [data-theme="dark"] .exec-table tbody tr:hover {
            background: rgba(197,155,39,0.08);
        }
        [data-theme="dark"] .card-panel,
        [data-theme="dark"] .card-custom,
        [data-theme="dark"] .kpi-tile {
            background: var(--surface);
            border-color: var(--border);
        }
        [data-theme="dark"] .pia-navbar {
            background: #0D2B1A;
            border-bottom-color: #1F4030;
        }
        [data-theme="dark"] .user-chip {
            background: #1A4231;
            border-color: rgba(197,155,39,0.25);
            color: #E0F0E8;
        }
        [data-theme="dark"] body {
            background-color: var(--forest-dark);
        }
        [data-theme="dark"] .card-panel-header,
        [data-theme="dark"] .card-panel-body {
            background: transparent;
        }
        [data-theme="dark"] .card-panel-title { color: #E0F0E8; }
        [data-theme="dark"] .kpi-label { color: #4D7A62; }
        [data-theme="dark"] .kpi-sub { color: #7DB899; }
        [data-theme="dark"] .text-dark, [data-theme="dark"] h1,
        [data-theme="dark"] h2, [data-theme="dark"] h3,
        [data-theme="dark"] h4, [data-theme="dark"] h5,
        [data-theme="dark"] h6 { color: #E0F0E8 !important; }
        [data-theme="dark"] .text-muted { color: #7DB899 !important; }
        [data-theme="dark"] .text-secondary { color: #4D7A62 !important; }
        [data-theme="dark"] .table { color: #E0F0E8; --bs-table-bg: transparent; }
        [data-theme="dark"] .table-light, [data-theme="dark"] .table-light th {
            background-color: var(--forest) !important;
            color: rgba(255,255,255,0.75) !important;
            border-color: #1F4030 !important;
        }
        [data-theme="dark"] td { border-color: #1F4030 !important; }
        [data-theme="dark"] .form-control, [data-theme="dark"] .form-select {
            background: #0A1F12;
            border-color: #1F4030;
            color: #E0F0E8;
        }
        [data-theme="dark"] .form-control:focus {
            background: #0D2B1A;
            border-color: var(--gold);
            color: #fff;
            box-shadow: 0 0 0 3px rgba(197,155,39,0.2);
        }
        [data-theme="dark"] .badge.bg-light {
            background-color: #1A4231 !important;
            color: #E0F0E8 !important;
        }
        [data-theme="dark"] .bg-white { background-color: #0D2B1A !important; }
        [data-theme="dark"] .border-bottom { border-color: #1F4030 !important; }
        [data-theme="dark"] .breadcrumb-item a { color: var(--gold) !important; }
        [data-theme="dark"] .alert-success { background: rgba(34,197,94,0.15); border-color: rgba(34,197,94,0.3); color: #86efac; }
        [data-theme="dark"] .alert-danger { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.3); color: #fca5a5; }

        /* ============================================================
           BUTTONS
        ============================================================ */
        .btn-gold {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
            color: #1A0F00;
            font-weight: 700;
            font-size: 13px;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            box-shadow: 0 4px 14px rgba(197,155,39,0.3);
            transition: all 0.25s;
            letter-spacing: 0.3px;
        }
        .btn-gold:hover {
            background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold) 100%);
            color: #1A0F00;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(197,155,39,0.4);
        }
        .btn-pia {
            background: linear-gradient(135deg, var(--forest) 0%, var(--forest-dark) 100%);
            color: #fff;
            font-weight: 600;
            font-size: 13px;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            box-shadow: 0 4px 14px rgba(0,60,30,0.25);
            transition: all 0.25s;
        }
        .btn-pia:hover {
            background: linear-gradient(135deg, var(--forest-light) 0%, var(--forest) 100%);
            color: #fff;
            transform: translateY(-1px);
        }
        .btn-pia-primary { /* alias */ composes: btn-pia; }
        .btn-pia-gold {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
            color: #1A0F00;
            font-weight: 700;
            font-size: 14px;
            border: none;
            border-radius: 10px;
            padding: 13px 28px;
            box-shadow: 0 4px 18px rgba(197,155,39,0.35);
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-pia-gold:hover {
            background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold) 100%);
            transform: translateY(-1px);
            box-shadow: 0 6px 22px rgba(197,155,39,0.45);
        }

        /* ============================================================
           STATUS BADGES
        ============================================================ */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        .status-badge.active { background: rgba(22,163,74,0.12); color: #16a34a; border: 1px solid rgba(22,163,74,0.25); }
        .status-badge.inactive { background: rgba(100,116,139,0.12); color: #64748b; border: 1px solid rgba(100,116,139,0.25); }
        .status-badge.pending { background: rgba(197,155,39,0.12); color: var(--gold-dark); border: 1px solid rgba(197,155,39,0.25); }
        .status-badge.paid { background: rgba(22,163,74,0.12); color: #16a34a; border: 1px solid rgba(22,163,74,0.25); }
        .status-badge.rejected { background: rgba(220,38,38,0.12); color: #dc2626; border: 1px solid rgba(220,38,38,0.25); }

        /* ============================================================
           FORMS
        ============================================================ */
        .form-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 6px;
        }
        .form-control, .form-select {
            border-radius: 8px;
            border: 1.5px solid var(--border);
            background: var(--surface);
            color: var(--text-primary);
            font-size: 13.5px;
            padding: 9px 14px;
            transition: all 0.2s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(197,155,39,0.15);
            background: var(--surface);
            color: var(--text-primary);
        }

        /* ============================================================
           PAGE HEADER
        ============================================================ */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }
        .page-header-left h4 {
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px;
        }
        .page-header-left p {
            font-size: 12px;
            color: var(--text-muted);
            margin: 0;
        }
        .breadcrumb { margin: 0; background: none; padding: 0; }
        .breadcrumb-item { font-size: 11.5px; }
        .breadcrumb-item a { color: var(--gold-dark); text-decoration: none; font-weight: 600; }
        .breadcrumb-item.active { color: var(--text-muted); }
        .breadcrumb-item + .breadcrumb-item::before { color: var(--text-light); }

        /* ============================================================
           TEXT COLORS
        ============================================================ */
        .text-gold { color: var(--gold); }
        .text-gold-dark { color: var(--gold-dark); }
        .text-forest { color: var(--forest); }
        .text-pia { color: var(--forest); }

        /* ============================================================
           PRINT
        ============================================================ */
        @@media print {
            .pia-sidebar, .telemetry-ribbon, .pia-navbar { display: none !important; }
            .main-wrapper { margin-left: 0 !important; padding-top: 0 !important; }
            .content-body { padding: 0 !important; }
            body { background: #fff !important; }
            .card-panel { box-shadow: none !important; border: 1px solid #ddd !important; }
        }

        /* ============================================================
           SCROLLBAR
        ============================================================ */
        .pia-sidebar::-webkit-scrollbar { width: 4px; }
        .pia-sidebar::-webkit-scrollbar-thumb { background: rgba(197,155,39,0.3); border-radius: 4px; }
    </style>
</head>
<body>

    <!-- ============================================================
         SIDEBAR
    ============================================================ -->
    <aside class="pia-sidebar d-print-none">
        <div class="sidebar-brand">
            <div class="sidebar-brand-logo-wrap">
                <img src="/images/pia-logo.png" alt="PIA Logo">
            </div>
        </div>

        <ul class="sidebar-nav mt-2">
            <div class="sidebar-section-label">Main Menu</div>

            <li>
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   href="/Home/Index">
                    <i class="fa-solid fa-chart-pie"></i> Executive Dashboard
                </a>
            </li>

            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <div class="sidebar-section-label mt-2">HR & Payroll</div>
                <li>
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")"
                       href="/Employee">
                        <i class="fa-solid fa-users"></i> Workforce Directory
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Payroll" ? "active" : "")"
                       href="/Payroll">
                        <i class="fa-solid fa-money-check-dollar"></i> Process Payroll
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Loan" ? "active" : "")"
                       href="/Loan">
                        <i class="fa-solid fa-list-check"></i> Loan Approvals
                    </a>
                </li>

                <div class="sidebar-section-label mt-2">Configuration</div>
                <li>
                    <a href="/Payroll/FlightAllowances">
                        <i class="fa-solid fa-plane-departure"></i> Flight Allowances
                    </a>
                </li>
                <li>
                    <a href="/Payroll/TaxSettings">
                        <i class="fa-solid fa-building-columns"></i> Tax & PF Slabs
                    </a>
                </li>
                <li>
                    <a href="/Payroll/Disbursement">
                        <i class="fa-solid fa-file-invoice-dollar"></i> Bank Disbursement
                    </a>
                </li>
            }

            @if (User.IsInRole("Employee") && !User.IsInRole("Admin") && !User.IsInRole("HR"))
            {
                <div class="sidebar-section-label mt-2">My Portal</div>
                <li>
                    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyProfile" ? "active" : "")"
                       href="/Employee/MyProfile">
                        <i class="fa-solid fa-user"></i> My Profile
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyLoans" ? "active" : "")"
                       href="/Loan/MyLoans">
                        <i class="fa-solid fa-hand-holding-dollar"></i> My Loans
                    </a>
                </li>
            }

            <div class="sidebar-section-label mt-2">Payslips</div>
            <li>
                <a href="/Payroll/MyPayslips">
                    <i class="fa-solid fa-receipt"></i> My Payslips
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="nav-link-btn text-danger" style="color:#ef4444 !important; gap:10px;">
                    <i class="fa-solid fa-right-from-bracket" style="color:#ef4444;"></i>
                    Sign Out
                </button>
            </form>
        </div>
    </aside>

    <!-- ============================================================
         TELEMETRY RIBBON
    ============================================================ -->
    <div class="telemetry-ribbon d-print-none">
        <div class="ribbon-pill">
            <span class="dot"></span>
            SYSTEM ONLINE
        </div>
        <div class="ribbon-pill">
            <span class="dot gold"></span>
            PIA PAYROLL &amp; HRMS v3.0
        </div>
        <div class="ribbon-pill">
            <span class="dot"></span>
            DATABASE CONNECTED
        </div>
        <div class="ribbon-pill">
            <span class="dot gold"></span>
            FISCAL YEAR 2026-27
        </div>
        <div class="ribbon-time" id="ribbon-clock"></div>
    </div>

    <!-- ============================================================
         MAIN NAVBAR
    ============================================================ -->
    <header class="pia-navbar d-print-none">
        <h1 class="navbar-page-title">@ViewData["Title"]</h1>
        <div class="navbar-right">
            <button id="themeToggle" class="theme-toggle-btn" title="Toggle Theme">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
            </button>
            <div class="user-chip">
                <div class="user-avatar">
                    @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U")
                </div>
                <span>@User.Identity?.Name</span>
            </div>
        </div>
    </header>

    <!-- ============================================================
         MAIN WRAPPER
    ============================================================ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="main-wrapper">
            <div class="content-body pt-0 pb-0">
                <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3 mb-0" role="alert"
                     style="border-radius: 10px; border-left: 4px solid #16a34a;">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="main-wrapper">
            <div class="content-body pt-0 pb-0">
                <div class="alert alert-danger alert-dismissible fade show shadow-sm mt-3 mb-0" role="alert"
                     style="border-radius: 10px; border-left: 4px solid #dc2626;">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }

    <div class="main-wrapper">
        <main class="content-body">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ── CLOCK ──────────────────────────────────────────────
        function updateClock() {
            const el = document.getElementById('ribbon-clock');
            if (!el) return;
            const now = new Date();
            el.textContent = now.toLocaleTimeString('en-US', { hour12: false }) + '  PKT';
        }
        updateClock();
        setInterval(updateClock, 1000);

        // ── THEME TOGGLE ───────────────────────────────────────
        const html = document.documentElement;
        const btn = document.getElementById('themeToggle');
        const icon = document.getElementById('themeIcon');

        function applyTheme(theme) {
            html.setAttribute('data-theme', theme);
            if (theme === 'dark') {
                icon.classList.replace('fa-moon', 'fa-sun');
            } else {
                icon.classList.replace('fa-sun', 'fa-moon');
            }
        }

        const saved = localStorage.getItem('pia-theme') || 'light';
        applyTheme(saved);

        btn.addEventListener('click', () => {
            const current = html.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            applyTheme(next);
            localStorage.setItem('pia-theme', next);
        });

        // ── ACTIVE NAV HIGHLIGHT ───────────────────────────────
        document.querySelectorAll('.sidebar-nav a').forEach(link => {
            if (link.href === window.location.href) {
                link.classList.add('active');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>