@{
    ViewData["Title"] = "Log In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PIA Payroll</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --pia-green: #005A36;
            --pia-green-dark: #003e25;
            --pia-green-light: #087548;
            --pia-gold: #D4AF37;
            --pia-gold-dark: #B8860B;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --bg-page: #eef3f7;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle at 10% 20%, rgba(0, 90, 54, 0.08) 0%, transparent 40%),
                        radial-gradient(circle at 90% 80%, rgba(212, 175, 55, 0.08) 0%, transparent 40%),
                        var(--bg-page);
            padding: 24px 16px;
        }

        .auth-container {
            width: 100%;
            max-width: 960px;
            background: #ffffff;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0, 40, 20, 0.12), 0 4px 16px rgba(0, 0, 0, 0.06);
            display: flex;
            min-height: 560px;
            position: relative;
        }

        .auth-left {
            flex: 1.05;
            position: relative;
            background: linear-gradient(145deg, rgba(0, 75, 45, 0.90) 0%, rgba(0, 35, 20, 0.94) 100%),
                        url('/images/pia-bg.jpg') center/cover no-repeat;
            padding: 48px 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #ffffff;
            overflow: hidden;
        }

        .auth-left::before {
            content: '';
            position: absolute;
            bottom: -50px;
            right: -50px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            pointer-events: none;
        }

        .auth-left-top {
            position: relative;
            z-index: 2;
        }

        .brand-logo-card {
            display: inline-block;
            background: #ffffff;
            padding: 10px 16px;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
            margin-bottom: 36px;
        }

        .brand-logo-card img {
            height: 55px;
            width: auto;
            object-fit: contain;
            display: block;
        }

        .auth-left-content {
            position: relative;
            z-index: 2;
            margin: auto 0;
        }

        .auth-left-content h1 {
            font-size: 32px;
            font-weight: 800;
            line-height: 1.25;
            margin-bottom: 12px;
            letter-spacing: -0.5px;
        }

        .accent-bar {
            width: 50px;
            height: 4px;
            background: var(--pia-gold);
            border-radius: 2px;
            margin-bottom: 20px;
        }

        .auth-left-content p {
            font-size: 14px;
            line-height: 1.65;
            color: rgba(255, 255, 255, 0.85);
            max-width: 360px;
            margin-bottom: 28px;
        }

        .btn-know-more {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: 30px;
            border: 1.5px solid rgba(255, 255, 255, 0.6);
            color: #ffffff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.3s ease;
            backdrop-filter: blur(4px);
        }

        .btn-know-more:hover {
            background: #ffffff;
            color: var(--pia-green);
            border-color: #ffffff;
            transform: translateY(-2px);
        }

        .auth-left-footer {
            position: relative;
            z-index: 2;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.6);
        }

        .split-circle-cutout {
            position: absolute;
            left: 48%;
            bottom: 60px;
            transform: translateX(-50%);
            width: 64px;
            height: 64px;
            background: #ffffff;
            border-radius: 50%;
            z-index: 3;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--pia-green);
            font-size: 20px;
        }

        .auth-right {
            flex: 1.1;
            padding: 48px 46px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #ffffff;
            position: relative;
        }

        .auth-header {
            margin-bottom: 28px;
        }

        .auth-header h2 {
            font-size: 28px;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 6px;
            letter-spacing: -0.5px;
        }

        .header-dash {
            width: 36px;
            height: 4px;
            background: var(--pia-green);
            border-radius: 2px;
            margin-bottom: 10px;
        }

        .auth-header p {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0;
        }

        .input-group-custom {
            margin-bottom: 20px;
        }

        .input-label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: var(--pia-green);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 6px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon-left {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--pia-green);
            font-size: 15px;
            pointer-events: none;
            transition: color 0.2s ease;
            z-index: 4;
        }

        .form-control-custom {
            width: 100%;
            height: 48px;
            padding: 10px 45px 10px 44px;
            border-radius: 30px;
            border: 1.5px solid var(--border-color);
            background-color: #f8fafc;
            color: #0f172a;
            font-size: 14px;
            font-weight: 500;
            outline: none;
            transition: all 0.25s ease;
        }

        .form-control-custom::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .form-control-custom:focus {
            background-color: #ffffff;
            border-color: var(--pia-green);
            box-shadow: 0 0 0 3px rgba(0, 90, 54, 0.15);
        }

        .input-wrapper:focus-within .input-icon-left {
            color: var(--pia-gold-dark);
        }

        .password-toggle {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--pia-green);
            font-size: 15px;
            cursor: pointer;
            padding: 4px;
            transition: all 0.2s ease;
            z-index: 4;
        }

        .password-toggle:hover {
            color: #000000;
            transform: translateY(-50%) scale(1.15);
        }

        .form-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            margin-bottom: 24px;
        }

        .remember-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-dark);
            cursor: pointer;
            user-select: none;
        }

        .remember-checkbox input {
            accent-color: var(--pia-green);
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .btn-auth-submit {
            width: 100%;
            height: 48px;
            border: none;
            border-radius: 30px;
            background: linear-gradient(135deg, var(--pia-green) 0%, var(--pia-green-dark) 100%);
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.5px;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(0, 90, 54, 0.28);
            transition: all 0.3s ease;
        }

        .btn-auth-submit:hover {
            background: linear-gradient(135deg, var(--pia-green-light) 0%, var(--pia-green) 100%);
            box-shadow: 0 10px 24px rgba(0, 90, 54, 0.38);
            transform: translateY(-1px);
        }

        .auth-switch-link {
            text-align: center;
            margin-top: 22px;
            font-size: 13px;
            color: var(--text-muted);
        }

        .auth-switch-link a {
            color: var(--pia-green);
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
        }

        @@media (max-width: 820px) {
            .auth-container {
                flex-direction: column;
                max-width: 480px;
            }
            .auth-left {
                padding: 36px 28px;
                min-height: 240px;
            }
            .split-circle-cutout {
                display: none;
            }
            .auth-right {
                padding: 36px 28px;
            }
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <!-- LEFT PANEL: Plane image + PIA Branding -->
        <div class="auth-left">
            <div class="auth-left-top">
                <div class="brand-logo-card">
                    <img src="/images/pia-logo.png" alt="Pakistan International Airlines Logo">
                </div>
            </div>

            <div class="auth-left-content">
                <h1>Welcome to PIA Payroll</h1>
                <div class="accent-bar"></div>
                <p>
                    Pakistan International Airlines Official Payroll & HRMS Portal. Access your monthly payslips, track allowances, submit loan requests, and manage staff records with enterprise-grade security.
                </p>
                <a href="https://www.piac.com.pk/" target="_blank" rel="noopener noreferrer" class="btn-know-more">
                    <i class="fa-solid fa-plane-departure"></i>
                    <span>Official Portal</span>
                </a>
            </div>

            <div class="auth-left-footer">
                &copy; @DateTime.Now.Year Pakistan International Airlines. All Rights Reserved.
            </div>
        </div>

        <div class="split-circle-cutout d-none d-lg-flex">
            <i class="fa-solid fa-plane"></i>
        </div>

        <!-- RIGHT PANEL: Sign In Form -->
        <div class="auth-right">
            <div class="auth-header">
                <h2>Sign In</h2>
                <div class="header-dash"></div>
                <p>Enter your corporate credentials to access your account</p>
            </div>

            <form method="post" action="/Account/Login">
                <div class="input-group-custom">
                    <label class="input-label">Employee ID / Official Email</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user input-icon-left"></i>
                        <input type="text" id="employeeIdInput" name="Username" class="form-control-custom" placeholder="employee@piapayroll.local" required autofocus />
                    </div>
                </div>

                <div class="input-group-custom">
                    <label class="input-label">Password</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-lock input-icon-left"></i>
                        <input type="password" id="passwordInput" name="Password" class="form-control-custom" placeholder="••••••••" required />
                        <i class="fa-regular fa-eye password-toggle" id="togglePasswordBtn" onclick="togglePasswordVisibility()" title="Toggle visibility"></i>
                    </div>
                </div>

                <div class="form-meta">
                    <label class="remember-checkbox">
                        <input type="checkbox" name="RememberMe" />
                        <span>Remember me</span>
                    </label>
                </div>

                <button type="submit" class="btn-auth-submit">
                    LOGIN
                </button>

                <div class="auth-switch-link">
                    <span>Don't have an account yet?</span>
                    <a href="/Identity/Account/Register">Register here</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordBtn');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>