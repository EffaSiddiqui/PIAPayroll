@model IEnumerable<PIA.Payroll.Domain.Entities.LoanRequest>
@{
    ViewData["Title"] = "Loan Approvals";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0"><i class="fa-solid fa-list-check me-2 text-primary"></i>Loan Requests</h4>
</div>

<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light text-secondary">
                <tr>
                    <th>Date</th>
                    <th>Employee</th>
                    <th>Amount</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>@loan.RequestDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="fw-bold">@loan.Employee.FirstName @loan.Employee.LastName</div>
                            <div class="small text-muted">@loan.Employee.EmployeeCode</div>
                        </td>
                        <td class="fw-bold">PKR @loan.Amount.ToString("N0")</td>
                        <td>@loan.Reason</td>
                        <td>
                            @if (loan.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (loan.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>
                            @if (loan.Status == "Pending")
                            {
                                <form asp-controller="Loan" asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@loan.Id" />
                                    <input type="hidden" name="status" value="Approved" />
                                    <input type="text" name="remarks" class="form-control form-control-sm d-inline-block w-auto" placeholder="Remarks..." />
                                    <button type="submit" class="btn btn-sm btn-success"><i class="fa-solid fa-check"></i></button>
                                </form>
                                <form asp-controller="Loan" asp-action="UpdateStatus" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="id" value="@loan.Id" />
                                    <input type="hidden" name="status" value="Rejected" />
                                    <input type="text" name="remarks" class="form-control form-control-sm d-inline-block w-auto" placeholder="Remarks..." />
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="fa-solid fa-xmark"></i></button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">@loan.AdminRemarks</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No loan requests found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
