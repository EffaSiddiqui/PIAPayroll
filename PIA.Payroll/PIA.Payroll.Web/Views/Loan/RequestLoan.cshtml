@{
    ViewData["Title"] = "Request Loan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0"><i class="fa-solid fa-hand-holding-dollar me-2 text-primary"></i>Request Loan</h4>
    <a href="/Loan/MyLoans" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</a>
</div>

<div class="card card-custom p-4 col-md-6">
    <form asp-action="RequestLoan" method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold">Loan Amount (PKR)</label>
            <input type="number" name="amount" class="form-control" required min="1000" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Reason for Loan</label>
            <textarea name="reason" class="form-control" rows="3" required></textarea>
        </div>
        <button type="submit" class="btn btn-pia w-100">Submit Request</button>
    </form>
</div>
