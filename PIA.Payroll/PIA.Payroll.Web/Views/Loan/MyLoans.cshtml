@model IEnumerable<PIA.Payroll.Domain.Entities.LoanRequest>
@{
    ViewData["Title"] = "My Loan Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0"><i class="fa-solid fa-hand-holding-dollar me-2 text-primary"></i>My Loan Requests</h4>
    <a href="/Loan/RequestLoan" class="btn btn-pia"><i class="fa-solid fa-plus me-1"></i> Request New Loan</a>
</div>

<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light text-secondary">
                <tr>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Admin Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>@loan.RequestDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                        <td class="fw-bold">PKR @loan.Amount.ToString("N0")</td>
                        <td>@loan.Reason</td>
                        <td>
                            @if (loan.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (loan.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>@loan.AdminRemarks</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No loan requests found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
